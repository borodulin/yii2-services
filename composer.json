{
    "name": "conquer/services",
    "description": "Yii2 soap wsdl web services",
    "keywords": [
        "yii2",
        "extension",
        "wsdl",
        "services",
        "soap"
    ],
    "homepage": "https://github.com/borodulin/yii2-services",
    "type": "yii2-extension",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Andrey Borodulin",
            "email": "borodulin@gmail.com"
        }
    ],
    "extra": {
        "branch-alias": {
            "dev-master": "1.6.x-dev"
        }
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "yiisoft/yii2": ">=2.0.6"
    },
    "require-dev": {
        "codeception/codeception": "^4.2 || ^5.0",
        "codeception/module-asserts": "^2.0 || ^3.0",
        "codeception/module-rest": "^2.0 || ^3.0",
        "codeception/module-yii2": "^1.1",
        "yiisoft/yii2-coding-standards": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "conquer\\services\\": ""
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    }
}
